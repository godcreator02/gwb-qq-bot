{
  "name": "@godcreator/gwb-qq-bot",
  "version": "0.1.0",
  "description": "QQ 官方机器人当通道：机器人收私聊与群 @ 消息，把任务文本转给运行中的 ZCode 桌面端执行，轮询结果后回推 QQ；按 openid 白名单只响应配置过的 QQ 用户。命令 2 条；skill 1 份。",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "keywords": [
    "gwb-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-qq-bot.git"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "scripts": {
    "build": "node build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "peerDependencies": {
    "@godcreator/gwb-commands": "^0.6.0",
    "@godcreator/gwb-kernel-desktop": "^0.10.1",
    "@godcreator/gwb-settings": "^0.4.0",
    "@godcreator/gwb-skills": "^0.4.13"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-skills": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "esbuild": "^0.28.2",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
